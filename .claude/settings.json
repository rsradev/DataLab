{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(poetry run pytest:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(jupyter nbconvert:*)",
      "Bash(pip list:*)",
      "Bash(pip show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./de-area/spark/metastore_db/**)",
      "Edit(./de-area/spark/spark-warehouse/**)"
    ]
  }
}
